{
  "name": "Custom Camera",
  "short_name": "Camera",
  "description": "Photo, video, document scan and QR reader that saves straight to Google Drive.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
